# Tech Stack Analyzer - Backend Env Example

# Network
PORT=5000
NODE_ENV=production

# Database (Recommended: MongoDB Atlas free tier)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tech-stack-analyzer

# Cache (Automated on Render if using render.yaml, or use Upstash)
REDIS_URL=redis://localhost:6379

# AI Logic (Get from openrouter.ai)
OPENROUTER_API_KEY=

# Security
# Set this to your frontend URL to allow CORS
FRONTEND_URL=https://tech-stack-analyzer.vercel.app
